# Optional server settings
PORT=3000
HOST=0.0.0.0

# Courtside currently uses server-side public data adapters and requires no API key.
# Never commit credentials if an authenticated provider is added later.
# Vercel deployment does not need PORT or HOST; those remain useful locally.

# Required for shared fantasy leagues on Vercel. Server-only credentials.
# Local Node uses .fantasy-data/ when neither variable is set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional isolation for preview deployments; use a separate database for production.
FANTASY_KEY_PREFIX=courtside:fantasy:v1:

# Required to authorize hosted background jobs. Also set this secret in GitHub Actions.
CRON_SECRET=
# GitHub Actions repository variable: your production HTTPS origin (no trailing path).
# COURTSIDE_BASE_URL=https://your-project.vercel.app
